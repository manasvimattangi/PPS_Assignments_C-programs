#include <stdio.h>

struct Student
{
    int rollno;
    char name[50];
    int marks1, marks2, marks3;
    int total;
    float percentage;
};

int main()
{
    struct Student s[50];
    int n, i;

    printf("Enter number of students: ");
    scanf("%d", &n);

    for(i = 0; i < n; i++)
    {
        printf("\nEnter details of student %d\n", i + 1);

        printf("Enter Roll Number: ");
        scanf("%d", &s[i].rollno);

        printf("Enter Name: ");
        scanf("%49s", s[i].name);

       	do
{
    printf("Enter marks in Subject 1 (1-100): ");
    scanf("%d", &s[i].marks1);

    if(s[i].marks1 < 1 || s[i].marks1 > 100)
    {
        printf("Invalid marks! Enter again.\n");
    }
} while(s[i].marks1 < 1 || s[i].marks1 > 100);
	do
{
    printf("Enter marks in Subject 2 (1-100): ");
    scanf("%d", &s[i].marks2);

    if(s[i].marks2 < 1 || s[i].marks2 > 100)
    {
        printf("Invalid marks! Enter again.\n");
    }
} while(s[i].marks2 < 1 || s[i].marks2 > 100);
	do
{
    printf("Enter marks in Subject 3 (1-100): ");
    scanf("%d", &s[i].marks3);

    if(s[i].marks3 < 1 || s[i].marks3 > 100)
    {
        printf("Invalid marks! Enter again.\n");
    }
} while(s[i].marks3 < 1 || s[i].marks3 > 100);

        s[i].total = s[i].marks1 +
                     s[i].marks2 +
                     s[i].marks3;

        s[i].percentage = s[i].total / 3.0;
    }

    printf("\n========== STUDENT RESULTS ==========\n");

    for(i = 0; i < n; i++)
    {
        printf("\nStudent %d\n", i + 1);
        printf("Roll Number: %d\n", s[i].rollno);
        printf("Name: %s\n", s[i].name);
        printf("Total Marks: %d\n", s[i].total);
        printf("Percentage: %.2f%%\n", s[i].percentage);
    }

    return 0;
}
